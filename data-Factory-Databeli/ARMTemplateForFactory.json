					{
						"name": "Set variable1",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "prep_email_subject",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "prep_email_body",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_final",
							"value": {
								"value": "{\n\t\"email_recipient\":\"@{pipeline().globalParameters.email_recipients}\",\n\t\"subject\":\"@{variables('email_subject_v')}\",\n\t\"body\":\"@{variables('body_final')}\"\n}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "prep_email_subject",
						"description": "hello",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
