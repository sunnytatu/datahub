							}
						}
					},
					{
						"name": "prep_email_body",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "body_final",
							"value": {
								"value": "@replace(string(pipeline().parameters.body),'\"','')",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"body": {
						"type": "array",
						"defaultValue": []
					}
				},
				"variables": {
					"email_subject_v": {
						"type": "String"
					},
					"email_body_v": {
						"type": "Array"
