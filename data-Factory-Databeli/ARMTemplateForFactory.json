									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update metadata.table_watermarks\nSET watermark_value='@{activity('max_modified_date').output.firstRow.max_time}'\nWHERE table_name='@{pipeline().parameters.table_name}'",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					},
					{
						"name": "Watermark_check",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
