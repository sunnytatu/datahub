												},
												"source": "demo-container"
											}
										}
									]
								},
								{
									"name": "max_modified_date",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "Table_ingestions",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
