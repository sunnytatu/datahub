							"method": "POST",
							"headers": {
								"Content-Type": "application/json"
							},
							"url": "https://prod-25.centralindia.logic.azure.com:443/workflows/42b09f9df8c543f3b5c4be7df430bdfb/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=Jzxn_-DfxxqMGhcXD0-1tsbKgd_FziLLsv4Pprc2w4Q",
							"body": {
								"value": "@variables('email_final')",
